# Supabase — project must be SEPARATE from DodiX. Create it via the
# Supabase dashboard/CLI, then fill these in (see lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.dirisoteloni1950.com

# WhatsApp Cloud API (Phase 6 — booking/quote notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Resend — configuratore notification (to Di Riso) + customer confirmation.
# RESEND_FROM must use a domain verified in Resend (dodiitalia.it is verified;
# dirisoteloni1950.com is NOT). Leave unset to use the default noreply@dodiitalia.it.
RESEND_API_KEY=
RESEND_FROM="Italia Coperta <noreply@dodiitalia.it>"

# Upstash Redis — rate limiting delle route pubbliche (SECURITY-AUDIT S-02).
# Se assenti il rate limiting è DISATTIVO (fail-open, con warning in console):
# un Redis irraggiungibile non deve bloccare i preventivi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — anti-spam sulle form pubbliche (SECURITY-AUDIT S-02).
# Senza TURNSTILE_SECRET_KEY la verifica server-side viene SALTATA (utile in
# sviluppo); senza la site key il widget non viene nemmeno renderizzato.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
