# Supabase — project must be SEPARATE from DodiX. Create it via the
# Supabase dashboard/CLI, then fill these in (see lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.dirisoteloni1950.com

# WhatsApp Cloud API (Phase 6 — booking/quote notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Resend — configuratore notification (to Di Riso) + customer confirmation.
# RESEND_FROM must use a domain verified in Resend (dodiitalia.it is verified;
# dirisoteloni1950.com is NOT). Leave unset to use the default noreply@dodiitalia.it.
RESEND_API_KEY=
RESEND_FROM="Italia Coperta <noreply@dodiitalia.it>"
